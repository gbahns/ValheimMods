<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>TheGreatestPortal</RootNamespace>
    <AssemblyName>TheGreatestPortal</AssemblyName>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- CS0436/CS8632 come from the vendored ServerSync/ConfigSync.cs (annotation type clash, nullable syntax). -->
    <NoWarn>$(NoWarn);MSB3277;CS0436;CS8632</NoWarn>
    <!-- C# 12 required by ServerSync/ConfigSync.cs (primary constructors, with-expressions). -->
    <LangVersion>12</LangVersion>
  </PropertyGroup>

  <!-- HarmonyX pulls in Mono.Cecil and MonoMod transitively.
       ServerSync is not on NuGet; ConfigSync.cs is bundled under ServerSync/ (needs JetBrainsAnnotations.cs). -->
  <ItemGroup>
    <PackageReference Include="HarmonyX" Version="2.9.0" />
  </ItemGroup>

  <!-- Local Valheim / Unity assemblies not on NuGet.  No Jotunn: this mod adds no prefabs and
       builds its UI by cloning the game's own text-input panel.
       Splatform.dll defines PlatformUserID, which appears in Minimap.AddPin's and
       Piece.SetCreator's signatures. -->
  <ItemGroup>
    <Reference Include="assembly_valheim_publicized">
      <HintPath>..\Libs\assembly_valheim_publicized.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_utils_publicized">
      <HintPath>..\Libs\assembly_utils_publicized.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_guiutils">
      <HintPath>..\Libs\assembly_guiutils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Splatform">
      <HintPath>..\Libs\Splatform.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>..\Libs\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The UnityEngine facade is needed alongside CoreModule or BaseUnityPlugin fails with CS0012. -->
    <Reference Include="UnityEngine">
      <HintPath>..\Libs\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\Libs\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Collider: the portal trigger volume. -->
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>..\Libs\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- KeyCode for keybinds. -->
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>..\Libs\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The portal panel and the map list: Canvas/RectTransform (UIModule), Button/ScrollRect/Toggle (UI),
         TextMeshProUGUI/TMP_InputField (TMP). -->
    <Reference Include="UnityEngine.UIModule">
      <HintPath>..\Libs\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>..\Libs\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>..\Libs\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>..\Libs\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
