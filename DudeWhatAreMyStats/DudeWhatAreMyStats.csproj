<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>DudeWhatAreMyStats</RootNamespace>
    <AssemblyName>DudeWhatAreMyStats</AssemblyName>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <LangVersion>12</LangVersion>
  </PropertyGroup>

  <!-- HarmonyX pulls in Mono.Cecil and MonoMod transitively.  No ServerSync: this mod is
       client-side only, holds no server-authoritative state and syncs no config. -->
  <ItemGroup>
    <PackageReference Include="HarmonyX" Version="2.9.0" />
  </ItemGroup>

  <!-- Local Valheim / Unity assemblies not on NuGet.  No Jotunn: this mod adds no prefabs and
       builds its UI by cloning the game's own text-input panel.
       Splatform.dll defines PlatformUserID / CrossNetworkUserInfo, which appear in
       ZNet.PlayerInfo and the PlayerProfile signatures this mod reads.

       DELIBERATELY the plain assemblies, not the _publicized ones the sibling mods use.
       Publicized assemblies exist only at build time; the game loads the real ones, where Mono
       does enforce access, so every private member they let you compile against becomes a
       FieldAccessException at runtime instead of an error here.  That cost this mod a release:
       Player.m_skills is private, it compiled clean against the publicized assembly, and in game
       it threw on every frame the panel was open and left the list empty.  Nothing here needs a
       private member, so referencing the real assemblies turns that whole class of bug into a
       compile error (verified: restoring Player.m_skills now fails the build with CS1061).
       If you ever do need a private member, reach it with reflection rather than switching these
       back, so the rest of the file keeps its compile-time guarantee. -->
  <ItemGroup>
    <Reference Include="assembly_valheim">
      <HintPath>..\Libs\assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>..\Libs\assembly_utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_guiutils">
      <HintPath>..\Libs\assembly_guiutils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Splatform">
      <HintPath>..\Libs\Splatform.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>..\Libs\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The UnityEngine facade is needed alongside CoreModule or BaseUnityPlugin fails with CS0012. -->
    <Reference Include="UnityEngine">
      <HintPath>..\Libs\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\Libs\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- KeyCode for keybinds. -->
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>..\Libs\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The stats panel: Canvas/RectTransform (UIModule), Button/ScrollRect/Toggle (UI),
         TextMeshProUGUI/TMP_InputField (TMP). -->
    <Reference Include="UnityEngine.UIModule">
      <HintPath>..\Libs\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>..\Libs\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>..\Libs\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>..\Libs\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
