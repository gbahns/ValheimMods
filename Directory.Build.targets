<Project>

  <!-- Where a local build goes.

       Every mod project used to carry its own copy of this target, and every copy deployed to
       EVERY Gale profile it could find, scattering loose DLLs into profiles that were supposed to
       be managed by Gale. One of them - StationExtensionGuard, which is unpublished and could only
       ever have arrived by a deploy - was still sitting in "Default SD" on 2026-09-23.

       Now there is one list, here:

         Default SD Test   THE PROFILE GREG PLAYS. Builds land here, deliberately: he wants a
                           build in his game without a round trip through Gale, and accepts that
                           what he is playing is whatever was last compiled.
         Default SD        a Gale-managed reference copy, kept honest so it can be compared with
                           what players actually receive. NEVER deploy here - anything loose in it
                           is a mistake, not a feature.

       An earlier version of this comment had those two the wrong way round, and cost an evening of
       advice about updating the profile Greg does not use.
         Default           production with the Wallybach/Badger HD set; otherwise the same as
                           "Default SD", which loads faster and is the one to test in.

       Override per build when you need to, without editing this file:
         dotnet build -c Release -p:DeployProfiles="Default SD Test;Limited Mods"
         dotnet build -c Release -p:DeployProfiles=none      (build only, copy nowhere) -->

  <PropertyGroup>
    <GaleProfiles>$(APPDATA)\com.kesomannen.gale\valheim\profiles</GaleProfiles>
    <DeployProfiles Condition="'$(DeployProfiles)' == ''">Default SD Test</DeployProfiles>
  </PropertyGroup>

  <!-- Only for mods: a project with a manifest.json is one, the test projects are not. -->
  <Target Name="DeployToProfiles" AfterTargets="Build"
          Condition="'$(DeployProfiles)' != 'none'
                     And Exists('$(GaleProfiles)')
                     And Exists('$(MSBuildProjectDirectory)\manifest.json')">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)deploy-to-profile.ps1&quot; -TargetName &quot;$(TargetName)&quot; -TargetPath &quot;$(TargetPath)&quot; -Profiles &quot;$(DeployProfiles)&quot;"
          ContinueOnError="true" />
  </Target>

</Project>
